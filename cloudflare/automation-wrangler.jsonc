{
  "name": "jobscope-automation",
  "main": "automation-worker.mjs",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  // Jobscope's only autonomous writer. The list stays empty until every
  // activation canary in OPERATIONS.md passes; adding a pattern here is the
  // single reviewable act that starts the clock. Patterns must match the
  // allowlist in automation-worker.mjs or the slot is rejected.
  "triggers": { "crons": [] },
  // Observe-only until explicitly promoted to "active": scheduled slots hit the
  // read-only status path and mutate nothing.
  "vars": { "AUTOMATION_MODE": "observe" }
}

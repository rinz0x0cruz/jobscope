# jobscope secrets. Copy to .env and fill in what you use. Never commit .env.

# Free AI backend (Groq recommended: fast, generous free tier).
# Get one at https://console.groq.com/keys
JOBSCOPE_AI_API_KEY=

# Gmail App Password for email summaries (NOT your normal password).
# https://myaccount.google.com/apppasswords
JOBSCOPE_SMTP_PASSWORD=

# Optional private-host automation secret (32+ random characters). The hosted
# service and the manual hosted workflows must receive the same value.
JOBSCOPE_AUTOMATION_TOKEN=

# Required with hosted automation: exact free automation Worker origin plus a
# separate 32+ character token shared only by that Worker and Railway.
JOBSCOPE_AUTOMATION_ORIGIN=
JOBSCOPE_AUTOMATION_EDGE_TOKEN=

# Required only for `serve --hosted`: exact Cloudflare Access team origin and
# Application Audience tag used to verify Cf-Access-Jwt-Assertion signatures.
JOBSCOPE_CF_ACCESS_TEAM_DOMAIN=
JOBSCOPE_CF_ACCESS_AUD=

# Whole-site encryption passphrase. In hosted mode encryption happens inside
# the private service; GitHub Actions receives ciphertext only.
JOBSCOPE_APPS_PASSPHRASE=

# Gmail App Password(s) for the `inbox` command (read-only IMAP application
# tracking). One per monitored account; names must match inbox.accounts[].password_env
# in config.yaml. Requires 2-Step Verification, then https://myaccount.google.com/apppasswords
JOBSCOPE_GMAIL_APP_PW=
JOBSCOPE_GMAIL_APP_PW_2=

# Optional: richer enrichment. All enrichment works without these.
FINNHUB_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
